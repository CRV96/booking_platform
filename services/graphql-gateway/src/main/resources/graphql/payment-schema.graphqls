extend type Mutation {
    """
    Start (or resume) payment for a booking. Returns the Stripe client secret the browser
    uses to confirm the card client-side. Idempotent per booking — a repeat call (e.g. a
    checkout page reload) returns the same intent rather than creating a new one.
    """
    createPaymentIntent(bookingId: ID!): PaymentIntent!

    """
    MOCK MODE ONLY. Simulate the payment outcome for a booking using a test card number
    (see docs/payment-test-cards.md: 4242… succeeds, 4000…0002 declines, etc.). Rejected by
    the backend when it runs against real Stripe — there the outcome comes from the webhook.
    """
    confirmMockPayment(bookingId: ID!, cardNumber: String!): PaymentIntent!
}

type PaymentIntent {
    paymentId: ID!
    bookingId: ID!
    externalPaymentId: String        # gateway PaymentIntent id (pi_...); null if not applicable
    clientSecret: String             # null when no card entry is needed (e.g. already paid)
    status: String!                  # PaymentStatus name (e.g. "PROCESSING", "COMPLETED")
}
