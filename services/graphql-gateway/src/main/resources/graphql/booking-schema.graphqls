extend type Query {
    """Get a booking by ID (authenticated user's own bookings only)"""
    booking(id: ID!): Booking

    """List the authenticated user's bookings with optional status filter"""
    myBookings(
        page: Int = 0
        pageSize: Int = 20
        status: BookingStatus
    ): BookingConnection!

    """All bookings for one of the organizer's own events (organizer-only) — for statistics."""
    eventBookings(eventId: ID!): [Booking!]!
}

extend type Mutation {
    """Create a new booking (reserves seats, returns PENDING booking)"""
    createBooking(input: CreateBookingInput!): Booking!

    """Cancel a booking (PENDING or CONFIRMED → CANCELLED, releases seats)"""
    cancelBooking(id: ID!, reason: String): Booking!

    """Discard an unpaid (PENDING) booking outright — releases seats, deletes it, no email. For abandoned checkout."""
    discardBooking(id: ID!): Boolean!
}

type Booking {
    id: ID!
    userId: String!
    eventId: String!
    eventTitle: String!
    status: BookingStatus!
    seatCategory: String!
    quantity: Int!
    unitPrice: String!           # Decimal as string ("49.99") — avoids float precision loss
    totalPrice: String!          # Decimal as string
    currency: String!            # ISO 4217 (e.g. "USD")
    idempotencyKey: String!
    holdExpiresAt: String        # ISO 8601 — null once booking leaves PENDING
    cancellationReason: String
    createdAt: String!           # ISO 8601
    updatedAt: String!           # ISO 8601
    """Live event details, hydrated from event-service (null if the event no longer exists)."""
    event: Event
}

enum BookingStatus {
    PENDING
    PAYMENT_PROCESSING
    CONFIRMED
    CANCELLED
    REFUND_PENDING
    REFUNDED
}

input CreateBookingInput {
    eventId: String!
    seatCategory: String!
    quantity: Int!
    idempotencyKey: String!      # Client-generated UUID — prevents duplicate submissions
}

type BookingConnection {
    bookings: [Booking!]!
    totalCount: Int!
    page: Int!
    pageSize: Int!
    totalPages: Int!
}
