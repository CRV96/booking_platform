extend type Query {
    """Get an event by ID (public)"""
    event(id: ID!): Event

    """Search and list events with optional filters (public). Pass organizerId to see all statuses for a specific organizer."""
    events(
        query: String
        category: EventCategory
        city: String
        dateFrom: String
        dateTo: String
        page: Int = 0
        pageSize: Int = 20
        organizerId: String
        """When true, also return semantic 'smart results' (see EventConnection.smartResults)."""
        aiSearch: Boolean = false
    ): EventConnection!
}

extend type Mutation {
    """Create a new event (employee only)"""
    createEvent(input: CreateEventInput!): Event!

    """Update an existing event (employee only)"""
    updateEvent(id: ID!, input: UpdateEventInput!): Event!

    """Publish a draft event (employee only)"""
    publishEvent(id: ID!): Event!

    """Cancel an event (employee only)"""
    cancelEvent(id: ID!): Event!
}

type Event {
    id: ID!
    title: String!
    description: String
    category: EventCategory!
    status: EventStatus!
    dateTime: String!
    endDateTime: String          # ISO 8601 — set when the event spans more than one day/session

    venue: VenueInfo!
    organizer: OrganizerInfo!
    seatCategories: [SeatCategory!]!
    images: [String!]            # image URLs; the first is used as the display image

    createdAt: String
    updatedAt: String
}

type VenueInfo {
    name: String!
    address: String
    city: String!
    country: String!
    latitude: Float
    longitude: Float
    capacity: Int
}

type OrganizerInfo {
    userId: String!
    name: String!
    email: String!
}

type SeatCategory {
    name: String!
    price: String!
    currency: String!
    totalSeats: Int!
    availableSeats: Int!
}

enum EventCategory {
    CONCERT
    SPORTS
    THEATRE
    CONFERENCE
    FESTIVAL
    OTHER
}

enum EventStatus {
    DRAFT
    PUBLISHED
    CANCELLED
    COMPLETED
}

input CreateEventInput {
    title: String!
    description: String
    category: EventCategory!
    dateTime: String!
    endDateTime: String
    venue: VenueInput!
    seatCategories: [SeatCategoryInput!]!
    images: [String!]
}

input UpdateEventInput {
    title: String
    description: String
    category: EventCategory
    dateTime: String
    endDateTime: String
    venue: VenueInput
    seatCategories: [SeatCategoryInput!]
    images: [String!]
}

input VenueInput {
    name: String!
    address: String
    city: String!
    country: String!
    latitude: Float
    longitude: Float
    capacity: Int
}

input SeatCategoryInput {
    name: String!
    price: Float!
    currency: String!
    totalSeats: Int!
}

type EventConnection {
    events: [Event!]!
    totalCount: Int!
    page: Int!
    pageSize: Int!
    totalPages: Int!
    """Semantic matches the keyword search did not return. Empty unless aiSearch: true."""
    smartResults: [Event!]!
}
